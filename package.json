{
  "name": "memo-graph",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": "10.33.2"
  },
  "scripts": {
    "build": "pnpm build:runtime",
    "build:runtime": "pnpm --filter @memo-graph/contracts build && pnpm --filter @memo-graph/storage-sqlite build && pnpm --filter @memo-graph/context-compiler build && pnpm --filter @memo-graph/memory-kernel build && pnpm --filter @memo-graph/mcp-server build",
    "build:storage": "pnpm --filter @memo-graph/contracts build && pnpm --filter @memo-graph/storage-sqlite build",
    "benchmark:storage": "pnpm build:storage && node packages/storage-sqlite/dist/benchmark.js",
    "benchmark:baseline": "pnpm build:runtime && node packages/memory-kernel/dist/benchmark.js",
    "benchmark:g3": "pnpm build:runtime && node scripts/run-g3-benchmark.mjs",
    "benchmark:g3:resources": "pnpm build:runtime && node scripts/run-g3-resource-benchmark.mjs",
    "lint": "eslint .",
    "test": "pnpm build:runtime && vitest run",
    "test:contract": "vitest run tests/contract",
    "test:fixtures": "vitest run tests/fixtures",
    "test:g3:accepted": "pnpm build:runtime && node scripts/run-g3-accepted-m2.mjs",
    "test:g3": "pnpm test:fixtures && pnpm build:runtime && vitest run tests/replay/layered-context-replay.test.ts tests/replay/context-pollution.test.ts tests/replay/projection-ablation.test.ts tests/integration/layered-runtime-regression.integration.test.ts tests/integration/layered-benchmark.integration.test.ts && pnpm test:g3:accepted",
    "test:integration": "pnpm build:runtime && vitest run tests/integration",
    "test:mcp": "pnpm build:runtime && vitest run tests/mcp",
    "test:recovery": "pnpm build:storage && vitest run tests/recovery",
    "test:storage": "pnpm build:storage && vitest run tests/storage",
    "typecheck": "pnpm build:runtime && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@memo-graph/storage-sqlite": "workspace:*",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.13.3",
    "better-sqlite3": "13.0.1",
    "eslint": "10.8.0",
    "globals": "17.8.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
